# Nano (XNO) Vending Machine Configuration

# Server Configuration
PORT=3007
NODE_ENV=development

# Nano (XNO) settlement configuration
# The Nano address that receives payment for every sale. Set this to YOUR
# address before going to production. A Nano address is 64 chars: nano_ + 60
# base-32 chars, first after the prefix is 1 or 3.
PAY_TO=nano_1111111111111111111111111111111111111111111111111117353trpda

# Public Nano RPC used for on-chain verification (keyless; no API key needed).
# NANO_RPC_BASE=https://rpc.nano.to

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/

# Optional: Redis for production storage
# REDIS_URL=redis://localhost:6379
